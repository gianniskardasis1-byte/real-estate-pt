//prisma/schema.prisma
generator client {
    provider = "prisma-client"      // Updated provider for v7
  output   = "../src/generated"   // MANDATORY: Specify an output folder
}

datasource db {
    provider = "mongodb"
    // url = env("DATABASE_URL") <--- REMOVE THIS LINE ENTIRELY
    
    
    
}


model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    name String?
    email String  @unique
    image String?
    bookedVisits Json[]
    favREsidenciesiD String[] @db.ObjectId
    ownedResidencies Residency[] @relation("Owner")
     
    }

    model Residency{
        id String @id @default(auto()) @map("_id") @db.ObjectId
        tittle String
        description String
        price Int
        address  String
        city String
        country String
        image String
        facilities Json
        userEmail String
        owner User @relation("Owner", fields:[userEmail], references: [email])
        createdAt DateTime @default(now())
        updateAt DateTime @updatedAt

     
    }