// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String      @unique
  image            String?
  bookedVisits     Json[]
  favResidenciesID String[]    @db.ObjectId
  ownedResidencies Residency[] @relation("Owner")
}

model Residency {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  price        Int
  address      String
  city         String
  country      String   @default("Greece")
  region       String?
  image        String
  images       String[]
  facilities   Json
  listingType  String   @default("sale")
  propertyType String   @default("apartment")
  area         Int?
  bedrooms     Int?
  bathrooms    Int?
  yearBuilt    Int?
  userEmail    String
  owner        User     @relation("Owner", fields: [userEmail], references: [email])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}