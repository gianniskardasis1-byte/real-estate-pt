// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  name             String?
  email            String      @unique
  image            String?
  bookedVisits     Json[]      @default([])
  favResidenciesID String[]    @default([])
  ownedResidencies Residency[] @relation("Owner")
}

model Residency {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String
  price        Int
  address      String
  city         String
  country      String   @default("Greece")
  region       String?
  image        String?
  images       String[] @default([])
  facilities   Json
  listingType  String   @default("sale")
  propertyType String   @default("apartment")
  area         Int?
  bedrooms     Int?
  bathrooms    Int?
  yearBuilt    Int?
  userEmail    String
  owner        User     @relation("Owner", fields: [userEmail], references: [email])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}